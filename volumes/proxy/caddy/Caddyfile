{
	admin off
}

{$NUVIO_DOMAIN} {
	encode zstd gzip

	@health path /health /healthz
	handle @health {
		header Content-Type "application/json; charset=utf-8"
		respond `{"service":"nuvio-backend","status":"ok"}` 200
	}

	@tv_login_public path /rest/v1/rpc/start_tv_login_session /rest/v1/rpc/poll_tv_login_session /functions/v1/tv-logins-exchange
	handle @tv_login_public {
		reverse_proxy kong:8000 {
			header_up apikey {$ANON_KEY}
			header_up Authorization "Bearer {$ANON_KEY}"
		}
	}

	@backend path /auth/v1 /auth/v1/* /rest/v1 /rest/v1/* /graphql/v1 /graphql/v1/* /realtime/v1 /realtime/v1/* /storage/v1 /storage/v1/* /functions/v1 /functions/v1/* /.well-known/oauth-authorization-server /sso/saml /sso/saml/* /api/mcp
	handle @backend {
		reverse_proxy kong:8000
	}

	handle {
		reverse_proxy account-dashboard:8080
	}

	header -Server
}
