# Adapted from Supabase self-hosting configuration and modified for Nuvio.
# Deployment mode. setup changes this when --domain is used.
COMPOSE_FILE=compose.yml
# Optional services. Supported profiles: studio,realtime
COMPOSE_PROFILES=
NUVIO_DOMAIN=localhost
NUVIO_ACCOUNT_DASHBOARD_IMAGE=ghcr.io/tapframe/nuvio-account-dashboard:latest
NUVIO_PUBLIC_SITE_URL=https://nuvio.tv
DEFAULT_CATALOG_URL=https://catalog.nuvio.tv/manifest.json
# Official Nuvio Cloud import source. The publishable key is public client
# configuration, not a service-role or database secret.
NUVIO_CLOUD_URL=https://api.nuvio.tv
NUVIO_CLOUD_PUBLISHABLE_KEY=sb_publishable_1Clq8rlTVACkdcZuqr6_AD__xUUC_EN
IMPORT_ACCOUNT_AFTER_UP=false

# Generated by ./nuvio setup. Never commit .env.
POSTGRES_PASSWORD=generate-me
JWT_SECRET=generate-me
ANON_KEY=generate-me
SERVICE_ROLE_KEY=generate-me
DASHBOARD_USERNAME=nuvio
DASHBOARD_PASSWORD=generate-me
SECRET_KEY_BASE=generate-me
VAULT_ENC_KEY=generate-me
PG_META_CRYPTO_KEY=generate-me
S3_PROTOCOL_ACCESS_KEY_ID=generate-me
S3_PROTOCOL_ACCESS_KEY_SECRET=generate-me
POOLER_TENANT_ID=generate-me

# Optional asymmetric and opaque API keys. Legacy JWT keys remain supported.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Public URLs.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000

# Database and connection pooler.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# Studio.
STUDIO_DEFAULT_ORGANIZATION=Nuvio Self-Hosted
STUDIO_DEFAULT_PROJECT=Nuvio
OPENAI_API_KEY=

# Auth. Email is auto-confirmed until an SMTP provider is configured.
JWT_EXPIRY=7200
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=true
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
MAILER_EXTERNAL_HOSTS=localhost
MAILER_SECURE_EMAIL_CHANGE_ENABLED=true
PASSWORD_MIN_LENGTH=6
AUTH_REFRESH_TOKEN_ROTATION_ENABLED=true
AUTH_REFRESH_TOKEN_REUSE_INTERVAL=120
RATE_LIMIT_TOKEN_REFRESH=150
RATE_LIMIT_ANONYMOUS_USERS=600
RATE_LIMIT_VERIFY=3000
RATE_LIMIT_HEADER=X-Forwarded-For
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Nuvio
MFA_TOTP_ENROLL_ENABLED=true
MFA_TOTP_VERIFY_ENABLED=true
MFA_MAX_ENROLLED_FACTORS=10
PASSKEY_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=Nuvio
WEBAUTHN_RP_ORIGINS=http://localhost:3000

# Storage.
GLOBAL_S3_BUCKET=nuvio
STORAGE_TENANT_ID=nuvio
REGION=local

# API and Edge Functions.
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
KONG_HTTP_PORT=8000
IMGPROXY_AUTO_WEBP=true
